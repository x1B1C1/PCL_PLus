<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.Pages.PageInstance.PageInstanceDependencies"
    PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10,25,10">

            <local:MyCard Margin="0,15,0,15" Title="{DynamicResource Instance.Dependencies.Title}">
                <StackPanel Margin="20,42,15,15">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.Dependencies.Description}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton MinWidth="130" Padding="13,0" ColorType="Highlight"
                                        Text="{DynamicResource Instance.Dependencies.Refresh}"
                                        Click="BtnRefresh_Click" />
                        <TextBlock x:Name="LabStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="12.5" />
                    </StackPanel>
                    <local:MyCheckBox x:Name="CheckDependencyOnLaunch" Margin="0,16,0,0"
                                      Text="{DynamicResource Instance.Dependencies.CheckOnLaunch}"
                                      ToolTip="{DynamicResource Instance.Dependencies.CheckOnLaunch.ToolTip}"
                                      Change="CheckDependencyOnLaunch_Change" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Instance.Dependencies.MissingTitle}"
                          x:Name="CardMissing">
                <StackPanel Margin="20,42,15,15">
                    <TextBlock x:Name="LabMissingEmpty" FontSize="12.5"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.Dependencies.MissingEmpty}" />
                    <StackPanel x:Name="PanMissing" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Instance.Dependencies.DisabledTitle}"
                          x:Name="CardDisabled">
                <StackPanel Margin="20,42,15,15">
                    <TextBlock x:Name="LabDisabledEmpty" FontSize="12.5"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.Dependencies.DisabledEmpty}" />
                    <StackPanel x:Name="PanDisabled" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
