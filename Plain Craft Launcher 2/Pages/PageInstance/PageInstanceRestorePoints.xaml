<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:val="https://ce.pclc.cc/core/utils/validate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.Pages.PageInstance.PageInstanceRestorePoints"
    PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10,25,10" x:Name="PanContent">

            <local:MyCard Margin="0,15,0,15" Title="{DynamicResource Instance.RestorePoints.Title}">
                <StackPanel Margin="25,42,20,20">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.RestorePoints.Description}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton MinWidth="140" Padding="13,0" ColorType="Highlight"
                                        Margin="0,0,12,0"
                                        Text="{DynamicResource Instance.RestorePoints.Create}"
                                        Click="BtnCreate_Click" />
                        <local:MyButton MinWidth="140" Padding="13,0"
                                        Text="{DynamicResource Instance.RestorePoints.OpenFolder}"
                                        Click="BtnOpenFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" CanSwap="True" IsSwapped="True"
                          Title="{DynamicResource Instance.RestorePoints.SettingsTitle}">
                <StackPanel Margin="25,40,15,20">
                    <local:MyCheckBox x:Name="CheckAutoCleanup" Change="CheckAutoCleanup_Change"
                                      Text="{DynamicResource Instance.RestorePoints.AutoCleanup}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Instance.RestorePoints.RetentionPrefix}"
                                   VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TextRetention" Width="65" MaxLength="3" Margin="8,0"
                                         HorizontalContentAlignment="Center" ShowValidateResult="False"
                                         ValidatedTextChanged="TextRetention_ValidatedTextChanged">
                            <local:MyTextBox.ValidateRules>
                                <val:IntValidator Min="1" Max="100" />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <TextBlock Text="{DynamicResource Instance.RestorePoints.RetentionSuffix}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.RestorePoints.RetentionTip}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" x:Name="CardPoints"
                          Title="{DynamicResource Instance.RestorePoints.ListTitle}" MinHeight="55">
                <Grid>
                    <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                HorizontalAlignment="Right" Height="28">
                        <local:MyIconTextButton x:Name="BtnRefresh" Click="BtnRefresh_Click"
                                                Text="{DynamicResource Common.Action.Refresh}"
                                                SvgIcon="lucide/refresh-cw" />
                    </StackPanel>
                </Grid>
                <StackPanel Margin="20,48,15,15">
                    <TextBlock x:Name="LabEmpty" Margin="5,2,0,12" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray4}"
                               Text="{DynamicResource Instance.RestorePoints.Empty}" />
                    <StackPanel x:Name="PanEntries" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
