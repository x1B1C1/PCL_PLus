<local:MyCard
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL.Controls"
    x:Class="PCL.Pages.PageInstance.Saves.WorldBackupGroup"
    CanSwap="True" IsSwapped="True" Margin="0,0,0,8">
    <StackPanel Margin="20,12,15,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabEmpty" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource ColorBrushGray4}" TextWrapping="Wrap"
                       Text="{DynamicResource Instance.Saves.Backup.Empty}" />
            <local:MyIconTextButton x:Name="BtnCreate" Grid.Column="1" SvgIcon="lucide/archive"
                                    Text="{DynamicResource Instance.Saves.Backup.Create}"
                                    Click="BtnCreate_Click" />
        </Grid>
        <StackPanel x:Name="PanPoints" Margin="0,8,0,0" />
    </StackPanel>
</local:MyCard>
