<local:MyPageRight x:Class="PCL.Pages.PageLink.PageLinkRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL.Controls"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <!--  联机：走 EasyTier 公共中继，创建与加入都在这一张卡里  -->
            <local:MyCard x:Name="CardLink" Margin="0,0,0,15" Title="{DynamicResource Tools.Link.Title}">
                <StackPanel Margin="25,38,25,18">
                    <local:MyCheckBox x:Name="CheckLinkEnabled"
                                      Text="{DynamicResource Tools.Link.Enable}"
                                      Change="LinkEnabled_Change" />
                    <StackPanel x:Name="PanLinkBody" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabIpv6Status"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <local:MyButton x:Name="BtnIpv6Refresh"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Text="{DynamicResource Link.Left.RefreshNet}"
                                            Click="BtnIpv6Refresh_Click" />
                        </Grid>

                        <TextBlock Margin="0,18,0,0"
                                   FontWeight="Bold"
                                   Text="{DynamicResource Link.Host.Step1Title}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{DynamicResource Link.Host.LanWaiting}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextHostPort"
                                             Grid.Column="0"
                                             Text="25565"
                                             HintText="{DynamicResource Link.Host.PortLabel}" />
                            <local:MyButton x:Name="BtnLinkHost"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Text="{DynamicResource Link.Host.StartBtn}"
                                            Click="BtnLinkHost_Click" />
                        </Grid>
                        <StackPanel x:Name="PanHostResult" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Link.Host.InviteHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <local:MyTextBox x:Name="TextHostInvite" Margin="0,6,0,0" IsReadOnly="True" />
                            <WrapPanel Margin="0,8,0,0">
                                <local:MyButton x:Name="BtnHostCopy"
                                                Margin="0,0,10,0"
                                                Text="{DynamicResource Link.Host.CopyAgain}"
                                                Click="BtnHostCopy_Click" />
                            </WrapPanel>
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Bold"
                                       Text="{DynamicResource Link.Host.Step2Title}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{DynamicResource Link.Host.AckDesc}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextHostAckInput"
                                                 Grid.Column="0"
                                                 HintText="{DynamicResource Link.Host.AckPlaceholder}" />
                                <local:MyButton x:Name="BtnHostAccept"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Text="{DynamicResource Link.Host.PasteAndAccept}"
                                                Click="BtnHostAccept_Click" />
                            </Grid>
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Bold"
                                       Text="{DynamicResource Link.Host.PeersTitle}" />
                            <TextBlock x:Name="LabHostPeers"
                                       Margin="0,6,0,0"
                                       Text="{DynamicResource Link.Host.NoPeers}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0"
                                   FontWeight="Bold"
                                   Text="{DynamicResource Link.Guest.Step1Title}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{DynamicResource Link.Guest.InviteHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextGuestInvite"
                                             Grid.Column="0"
                                             HintText="{DynamicResource Link.Guest.InvitePlaceholder}" />
                            <local:MyButton x:Name="BtnLinkJoin"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Text="{DynamicResource Link.Guest.PasteAndConnect}"
                                            Click="BtnLinkJoin_Click" />
                        </Grid>
                        <StackPanel x:Name="PanGuestResult" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="LabGuestStatus" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       FontWeight="Bold"
                                       Text="{DynamicResource Link.Guest.Step2Title}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{DynamicResource Link.Guest.AckExplain}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <local:MyTextBox x:Name="TextGuestAck" Margin="0,6,0,0" IsReadOnly="True" />
                            <WrapPanel Margin="0,8,0,0">
                                <local:MyButton x:Name="BtnGuestAckCopy"
                                                Margin="0,0,10,0"
                                                Text="{DynamicResource Link.Guest.CopyAck}"
                                                Click="BtnGuestAckCopy_Click" />
                                <local:MyButton x:Name="BtnLinkLeave"
                                                Text="{DynamicResource Link.Guest.DisconnectBtn}"
                                                Click="BtnLinkLeave_Click" />
                            </WrapPanel>
                            <TextBlock Margin="0,12,0,0"
                                       Text="{DynamicResource Link.Guest.FallbackAddrHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextGuestAddr" Grid.Column="0" IsReadOnly="True" />
                                <local:MyButton x:Name="BtnGuestAddrCopy"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Text="{DynamicResource Link.Guest.CopyAddr}"
                                                Click="BtnGuestAddrCopy_Click" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="LabLinkStatus"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               Text="{DynamicResource Tools.Link.Note}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
