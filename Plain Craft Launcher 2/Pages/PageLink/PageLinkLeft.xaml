<local:MyPageLeft x:Class="PCL.Pages.PageLink.PageLinkLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL.Controls"
                  mc:Ignorable="d">
    <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

        <TextBlock Text="{DynamicResource Link.Left.Category}" Margin="13,5,5,3" Opacity="0.6" FontSize="12" />
        <local:MyListItem x:Name="ItemDirect"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="0"
                          MinPaddingRight="35" Height="34" FontSize="13"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Link.Left.Direct}" Check="PageCheck"
                          LogoScale="0.82"
                          SvgIcon="lucide/share-2" />

        <TextBlock Text="{DynamicResource Link.Left.Tip}"
                   Margin="13,14,13,0"
                   TextWrapping="Wrap"
                   Opacity="0.65"
                   FontSize="12" />
    </StackPanel>
</local:MyPageLeft>
