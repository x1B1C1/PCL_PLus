<local:MyPageRight x:Class="PCL.Pages.PageLaunch.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL.Controls"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanCustom" />
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Welcome.Community.Title}" x:Name="PanCommunity">
                <StackPanel Margin="25,38,25,18">
                    <local:MyTextButton x:Name="BtnJoinGroup" Text="{DynamicResource Community.Qq.Link}"
                                        FontSize="13" HorizontalAlignment="Left" Click="BtnJoinGroup_Click" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                                 AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
