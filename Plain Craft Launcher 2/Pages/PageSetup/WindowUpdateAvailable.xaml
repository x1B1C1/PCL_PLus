<Window x:Class="PCL.Pages.PageSetup.WindowUpdateAvailable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL.Controls"
        Title="发现新版本" Width="720" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FF14161A" Foreground="#FFEDF2F8"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <!-- 与更新说明窗口同一套覆盖：黑底、白字、蓝按钮，不随外部主题变化 -->
    <Window.Resources>
        <SolidColorBrush x:Key="ColorBrush1" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ColorBrush2" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ColorBrush3" Color="#FFE8F7FF" />
        <SolidColorBrush x:Key="ColorBrush7" Color="#FF33C5FF" />
        <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#FF00B7FF" />
        <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#00000000" />
    </Window.Resources>
    <Grid Margin="30,22,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="发现新版本" FontSize="23" FontWeight="SemiBold" Foreground="#FFF2F6FB" />
                <TextBlock x:Name="LabLatest" FontSize="23" FontWeight="SemiBold" Foreground="#FF00B7FF"
                           Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="LabCurrent" FontSize="13" Margin="0,6,0,0" Foreground="#FFA8B4C4" TextWrapping="Wrap" />
            <Rectangle Height="1" Margin="0,14,0,0" Fill="#FF2A2F38" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="PanChangelog" TextWrapping="Wrap" LineHeight="21" Foreground="#FFC9D3DF" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="LabHint" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#FFA8B4C4" TextWrapping="Wrap" MaxWidth="420" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <local:MyButton x:Name="BtnLater" Text="稍后再说" Height="32" Padding="16,0"
                                Margin="0,0,10,0" Click="BtnLater_Click" />
                <local:MyButton x:Name="BtnUpdate" Text="立即更新" Height="32" Padding="20,0"
                                ColorType="Highlight" Click="BtnUpdate_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
