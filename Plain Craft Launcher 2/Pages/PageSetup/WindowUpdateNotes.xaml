<Window x:Class="PCL.Pages.PageSetup.WindowUpdateNotes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL.Controls"
        Title="更新说明" Width="760" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FF14161A" Foreground="#FFEDF2F8"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <!-- 窗口内覆盖主题键：黑底上的按钮统一为蓝底白字，不随外部主题变化 -->
    <Window.Resources>
        <SolidColorBrush x:Key="ColorBrush1" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ColorBrush2" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ColorBrush3" Color="#FFE8F7FF" />
        <SolidColorBrush x:Key="ColorBrush7" Color="#FF33C5FF" />
        <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#FF00B7FF" />
        <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#00000000" />
    </Window.Resources>
    <Grid Margin="30,22,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PCL_Plus" FontSize="23" FontWeight="SemiBold" Foreground="#FFF2F6FB" />
                <TextBlock x:Name="LabVersion" FontSize="23" FontWeight="SemiBold" Foreground="#FF00B7FF"
                           Margin="8,0,0,0" />
                <TextBlock Text=" 更新说明" FontSize="23" FontWeight="SemiBold" Foreground="#FFF2F6FB" />
            </StackPanel>
            <TextBlock x:Name="LabSubtitle" FontSize="13" Margin="0,6,0,0"
                       Foreground="#FFA8B4C4" TextWrapping="Wrap" />
            <Rectangle Height="1" Margin="0,14,0,0" Fill="#FF2A2F38" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanNotes" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <local:MyCheckBox x:Name="CheckDismiss" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Text="下次更新前不再弹出" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <local:MyButton x:Name="BtnRelease" Text="查看发布页" Height="32" Padding="14,0"
                                Margin="0,0,10,0" Click="BtnRelease_Click" />
                <local:MyButton x:Name="BtnOk" Text="确定" Height="32" Padding="20,0"
                                ColorType="Highlight" Click="BtnOk_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
