<Window x:Class="PCL.Pages.PageSetup.WindowUpdateNotes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL.Controls"
        Title="更新说明" Width="760" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ColorBrush8}" Foreground="{DynamicResource ColorBrush1}"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="30,22,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="LabTitle" FontSize="23" FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush3}" TextWrapping="Wrap" />
            <TextBlock x:Name="LabSubtitle" FontSize="13" Margin="0,6,0,0"
                       Foreground="{DynamicResource ColorBrushTextSecondary}" TextWrapping="Wrap" />
            <Rectangle Height="1" Margin="0,14,0,0" Fill="{DynamicResource ColorBrush6}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanNotes" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <local:MyCheckBox x:Name="CheckDismiss" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Text="下次更新前不再弹出" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <local:MyButton x:Name="BtnRelease" Text="查看发布页" Height="32" Padding="14,0"
                                Margin="0,0,10,0" Click="BtnRelease_Click" />
                <local:MyButton x:Name="BtnOk" Text="确定" Height="32" Padding="20,0"
                                ColorType="Highlight" Click="BtnOk_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
