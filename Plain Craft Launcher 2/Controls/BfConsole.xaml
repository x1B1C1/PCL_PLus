<UserControl x:Class="PCL.Controls.BfConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL.Controls"
             Background="Transparent">
    <StackPanel>
        <TextBlock x:Name="TextIntro" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="#F2F6FD">
            <TextBox x:Name="TextOutput" Height="300" IsReadOnly="True" AcceptsReturn="True"
                     Focusable="False" SelectionBrush="Transparent"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12.5" Background="#F2F6FD"
                     BorderThickness="0" IsTabStop="False" />
        </Border>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyTextBox x:Name="TextCommand" Grid.Column="0" Margin="0,0,10,0"
                             KeyDown="TextCommand_KeyDown" />
            <local:MyButton x:Name="BtnRun" Grid.Column="1" MinWidth="90" Text="执行"
                            Click="BtnRun_Click" />
            <local:MyButton x:Name="BtnClear" Grid.Column="2" MinWidth="70" Text="清空"
                            Margin="10,0,0,0" Click="BtnClear_Click" />
        </Grid>
        <TextBlock x:Name="TextStatus" Margin="2,8,0,0" FontSize="11.5" Opacity="0.55" Text="就绪" />
    </StackPanel>
</UserControl>
