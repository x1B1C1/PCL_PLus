<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PCL</RootNamespace>
        <MyType>Custom</MyType>
        <IsWebBootstrapper>false</IsWebBootstrapper>
        <StartupObject>PCL.Program</StartupObject>
        <PublishUrl>publish\</PublishUrl>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <MapFileExtensions>true</MapFileExtensions>
        <TargetCulture>zh-CN</TargetCulture>
        <UseApplicationTrust>false</UseApplicationTrust>
        <BootstrapperEnabled>true</BootstrapperEnabled>
        <LangVersion>14</LangVersion>
        <UseWPF>true</UseWPF>
        <Configurations>Beta;Debug;Release;CI</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Images\icon.ico</ApplicationIcon>
        <AssemblyTitle>PCL_Plus</AssemblyTitle>
        <Description>Minecraft 启动器 (PCL_Plus)</Description>
        <Product>PCL_Plus</Product>
        <Company>xL1nUwU</Company>
        <Authors>xL1nUwU</Authors>
        <Copyright>© 2026 xL1nUwU</Copyright>
        <Trademark>PCL_Plus</Trademark>
        <!--
            版本号唯一真源是 metadata.json，这里不再手写。
            以前两处各写一份，发版时漏改其中一处就会出现「装完还是旧版本号、
            更新检查永远认为有新版本」的死循环（1.3.1 -> 1.3.2 就是这么翻的车）。
        -->
        <PclMetadataFile>$(MSBuildProjectDirectory)\metadata.json</PclMetadataFile>
        <PclMetadataJson>$([System.IO.File]::ReadAllText('$(PclMetadataFile)'))</PclMetadataJson>
        <PclVersionBase>$([System.Text.RegularExpressions.Regex]::Match($(PclMetadataJson), '(?&lt;="base"\s*:\s*")[^"]+'))</PclVersionBase>
        <PclVersionSuffix>$([System.Text.RegularExpressions.Regex]::Match($(PclMetadataJson), '(?&lt;="suffix"\s*:\s*")[^"]*'))</PclVersionSuffix>
        <AssemblyVersion>$(PclVersionBase).0</AssemblyVersion>
        <FileVersion>$(PclVersionBase).0</FileVersion>
        <InformationalVersion Condition="'$(PclVersionSuffix)' == ''">$(PclVersionBase)</InformationalVersion>
        <!-- 发布标记 R 是正式版，习惯写法紧贴版本号（1.1.1R），与界面显示保持一致 -->
        <InformationalVersion Condition="'$(PclVersionSuffix)' == 'R'">$(PclVersionBase)R</InformationalVersion>
        <InformationalVersion Condition="'$(PclVersionSuffix)' != '' and '$(PclVersionSuffix)' != 'R'">$(PclVersionBase)-$(PclVersionSuffix)</InformationalVersion>
        <NoWarn>
            41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314;
            VSTHRD002;VSTHRD003;VSTHRD110;VSTHRD200
        </NoWarn>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
        <CETCompat>false</CETCompat>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>bin\Debug\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'CI' Or '$(Configuration)' == 'DebugCI'">
        <OutputPath>bin\CI\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUGCI</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>bin\Release\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>RELEASE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
        <OutputPath>bin\Beta\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>BETA</DefineConstants>
    </PropertyGroup>
    <!--
        【调试专属模块】BF 调试代码开关。
        build-release.ps1 只在 metadata.json suffix=bf 时传 -p:BfDebug=true，
        其余构建（正式线 / 测试线）不带该常量，调试页、右侧日志面板与 hwid 命令
        会被预处理器整段排除，对外包里不残留任何调试代码。
    -->
    <PropertyGroup Condition="'$(BfDebug)' == 'true'">
        <DefineConstants>$(DefineConstants);BF_DEBUG</DefineConstants>
    </PropertyGroup>
    <!--
        【调试专属模块】把构建机的 HWID 写进程序集元数据（AssemblyMetadata），
        启动时用 BfHwidGuard 比对并弹窗。这里不用 AssemblyMetadata 项，而是每次构建
        生成/删除 BfHwid.g.cs：BfHwid 为空时必须删掉旧文件，否则增量编译会把上一次
        BF 构建的 HWID 残留在正式 / 测试包里。
    -->
    <Target Name="GenerateBfHwidMetadata" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_BfHwidFile>$(IntermediateOutputPath)BfHwid.g.cs</_BfHwidFile>
        </PropertyGroup>
        <WriteLinesToFile Condition="'$(BfHwid)' != ''"
                          File="$(_BfHwidFile)"
                          Lines="[assembly: System.Reflection.AssemblyMetadata(&quot;BfHwid&quot;, &quot;$(BfHwid)&quot;)]"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <Delete Condition="'$(BfHwid)' == '' And Exists('$(_BfHwidFile)')" Files="$(_BfHwidFile)" />
        <ItemGroup Condition="'$(BfHwid)' != ''">
            <Compile Include="$(_BfHwidFile)" />
            <FileWrites Include="$(_BfHwidFile)" />
        </ItemGroup>
    </Target>
    <!--
        【调试专属模块】不带 BfHwid 的构建无需额外处理：GenerateBfHwidMetadata 已保证
        不再生成任何 HWID 元数据；发布脚本 build-release.ps1 在打包前会清掉 obj/bin，
        因此正式 / 测试包不会复用 BF 构建留下的中间产物。
    -->
    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="DotNet.Glob" Version="3.1.3" />
        <PackageReference Include="Downloader" Version="5.9.4" />
        <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="NAudio" Version="2.3.0" />
        <PackageReference Include="protobuf-net" Version="3.2.56" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
    </ItemGroup>
    <ItemGroup>
        <Import Include="System.IO" />
        <Import Include="System.Net" />
        <Import Include="System.Text" />
        <Import Include="System.Threading" />
        <Import Include="System.Windows" />
        <Import Include="System.Windows.Controls" />
        <Import Include="System.Windows.Data" />
        <Import Include="System.Windows.Documents" />
        <Import Include="System.Windows.Input" />
        <Import Include="System.Windows.Shapes" />
        <Import Include="System.Windows.Media" />
        <Import Include="System.Windows.Media.Imaging" />
    </ItemGroup>
    <!-- 信不过巨硬的智障代码，手动包含需要的文件 -->
    <PropertyGroup>
        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <EnableDefaultPageItems>false</EnableDefaultPageItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="**\*.cs" Exclude="bin\**;obj\**;publish\**" />
        <ApplicationDefinition Include="Application.xaml" Condition="Exists('Application.xaml')" />
        <ApplicationDefinition Include="App.xaml" Condition="Exists('App.xaml')" />
        <Page Include="**\*.xaml" Exclude="bin\**;obj\**;@(ApplicationDefinition)" />
        <Resource Include="Images\**" />
        <Resource Include="Resources\**" />
        <EmbeddedResource Include="metadata.json" />
    <!-- 内置插件：启动时释放到 PCL\Plugins，缺失或损坏会重新写出 -->
    <EmbeddedResource Include="Resources\Plugins\IMCProxy-2.0.0.pclplugin" LogicalName="PCL.Plugins.IMCProxy.pclplugin" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="LICENCE" />
    </ItemGroup>
    <!-- ===== [新增] 内置陶瓦联机运行文件（未经修改的 0.4.2 发行版二进制） ===== -->
    <ItemGroup>
        <EmbeddedResource Include="Modules\Terracotta\Runtime\terracotta.exe"
                          LogicalName="PCL.Terracotta.Runtime.terracotta.exe" />
        <EmbeddedResource Include="Modules\Terracotta\Runtime\VCRUNTIME140.DLL"
                          LogicalName="PCL.Terracotta.Runtime.VCRUNTIME140.DLL" />
    </ItemGroup>
</Project>
